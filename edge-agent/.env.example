# Copy to .env and adjust. No storage directory needed (uses a named volume).

# External Docker network shared with other stacks.
SHARED_DOCKER_NETWORK=cloudflared_shared-network

# Default Storage Folder
DEFAULT_STORAGE_FOLDER=/storage/portainer

# Agent image (pinned; keep in line with your Portainer server version).
PORTAINER_AGENT_IMAGE=portainer/agent:2.45.3

# Infisical agent image (pinned) and static busybox image (pinned; needs a static build, e.g. -musl).
INFISICAL_CLI_IMAGE=infisical/cli:0.44.15
BUSYBOX_IMAGE=busybox:1.38.0-musl

# Moved to Infisical but kept for debugging purposes (compose does not read these; store them as
# secrets PORTAINER_EDGE_ID / PORTAINER_EDGE_KEY in Infisical). Never commit real values.
# From Portainer UI -> Environments -> Add Environment -> Edge Agent.
# PORTAINER_EDGE_ID=<replace_with_edge_id>
# PORTAINER_EDGE_KEY=<replace_with_edge_key>

# Set to 1 to allow non-TLS polling (development only).
PORTAINER_EDGE_INSECURE_POLL=0

# Agent log level: DEBUG | INFO | WARN | ERROR
PORTAINER_LOG_LEVEL=INFO

# Agent Cluster Address
AGENT_CLUSTER_ADDR=portainer-agent