# Copy to .env and adjust. Run `sudo ../create_volumes.sh host` first.

# External Docker network shared with other stacks (e.g. cloudflared).
SHARED_DOCKER_NETWORK=cloudflared_shared-network

# Base directory for Portainer storage (bind-mounted at <dir>/data).
DEFAULT_STORAGE_FOLDER=/storage/portainer

# Portainer image tag (pinned; bump deliberately after reading release notes).
PORTAINER_VERSION=2.45.3

# Host port for the Portainer UI (container 9443, HTTPS), bound to 127.0.0.1.
PORTAINER_HTTPS_PORT=9443
