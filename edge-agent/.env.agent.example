# Copy to .env.agent, then: chmod 600 .env.agent
# Universal Auth identity: read-only, scoped to one project/env/path.
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=<replace_with_client_id>
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=<replace_with_client_secret>
INFISICAL_ADDRESS=https://app.infisical.com
INFISICAL_PROJECT_ID=<replace_with_project_id>
INFISICAL_ENV=prod
