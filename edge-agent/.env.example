# Copy to .env and adjust. No storage directory needed (uses a named volume).

# External Docker network shared with other stacks.
SHARED_DOCKER_NETWORK=cloudflared_shared-network

# Agent image tag (pinned; keep in line with your Portainer server version).
PORTAINER_VERSION=2.45.3

# From Portainer UI -> Environments -> Add Environment -> Edge Agent.
# Never commit real values.
PORTAINER_EDGE_ID=<replace_with_edge_id>
PORTAINER_EDGE_KEY=<replace_with_edge_key>

# Set to 1 to allow non-TLS polling (development only).
PORTAINER_EDGE_INSECURE_POLL=0

# Agent log level: DEBUG | INFO | WARN | ERROR
PORTAINER_LOG_LEVEL=INFO
